// Marta Anselm, Dov's sister, four years in the Lull. Her postcard says exactly the same thing every month.
npc: marta_anselm
name: Marta Anselm
start: disrupted [flag:lull_disrupted]
start: back [flag:met_marta]
start: first

node: disrupted
  marta_anselm (stricken): "I was happy. I was so happy. Why am I crying? Four years. I wrote him four years of the same card and I do not remember one day of them. Why did you wake me?"
  > [clue:dov_sister_lull] "Your brother Dov has been waiting for you." -> dov_wake
  > "I am sorry." -> goodbye

node: dov_wake
  marta_anselm (stricken): "Dov. Oh, Dov. I will go to him. I do not want to, and I will. Leave me a moment."
  > "Take as long as you need." -> goodbye

node: first
  on_enter: {flag:met_marta}
  marta_anselm (bright): "I am having a lovely time. I write my brother every month to tell him so. Wish you were here! Would you like to carry a card for me?"
  > [clue:dov_sister_lull] "Dov says hello." -> dov
  > "Another time." -> goodbye

node: back
  marta_anselm (bright): "I am having a lovely time. Wish you were here."
  > [clue:dov_sister_lull] "Dov says hello." -> dov
  > "Goodbye." -> goodbye

node: dov
  marta_anselm (bright): "Dov? Oh, he worries. Tell him I am having a lovely time."
  > "I will." -> goodbye

node: goodbye
  marta_anselm (bright): "Do come again."
  end
