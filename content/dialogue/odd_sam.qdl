// Odd Sam, fixer and fence in the Stacks. Vertical-slice conversation: he sells and trades information.
// Demonstrates: clue-gated options, buying a clue, and presenting clues whose reliability Sam can judge.
npc: odd_sam
name: Odd Sam
start: return_visit [flag:met_sam]
start: first_meeting

node: first_meeting
  on_enter: {flag:met_sam}
  odd_sam (wry): "New face. No band worth reading, and yet here you are. Everything I sell is a bargain relative to inflation, which is ongoing."
  > "What do you sell?" -> wares
  > "Never mind." -> goodbye

node: return_visit
  odd_sam (amused): "Back again. My prices haven't moved. Prices only move one way."
  > "What do you sell?" -> wares
  > [clue:pump4_shift] "I heard the night shift at Pump 4 leaves the side door unlocked." -> pump4_claim
  > "I have something to show you." -> show
  > "Goodbye." -> goodbye

node: wares
  odd_sam: "Rumours, mostly. The Pump 4 night shift, for twenty credits. Or a free sample, if you don't mind it being stale."
  > [credits>=20, !clue:pump4_shift] "Buy the Pump 4 rumour. (20 credits)" {-credits:20, +clue:pump4_shift(odd_sam)} -> sold
  > [credits>=30, !clue:maint_override] "Ask about the maintenance panel. (30 credits)" {-credits:30, +clue:maint_override(odd_sam)} -> override
  > [credits>=10, augment:slow_tongue, !clue:pump4_shift] "Haggle, slowly and soothingly. (10 credits)" {-credits:10, +clue:pump4_shift(odd_sam)} -> haggled
  > [!clue:pump4_shift_old] "Take the free sample." {+clue:pump4_shift_old(odd_sam)} -> sample
  > "Ask about papers. (40 credits)" {service:forge_stacks_pass} -> deal
  > [quiet] "Ask about the night records. (15 credits)" {service:quiet_hours_forgery} -> deal
  > "Sell scrap wire. (2 bundles)" {service:sell_scrap} -> deal
  > [!debt:odd_sam] "Ask for a loan. (40 credits, and I owe more every day)" {loan:odd_sam*40} -> loaned
  > [debt:odd_sam, credits>=1] "Pay back some of what I owe. (up to 30)" {repay:odd_sam*30} -> deal
  > "Not now." -> return_visit

node: deal
  odd_sam: "Business is business."
  > "Anything else?" -> wares
  > "That will do." -> return_visit

node: loaned
  odd_sam (warm): "Forty, in your hand. I charge a quarter a day, and after two days I send someone to collect. Nothing personal. I am simply fond of arithmetic."
  > "Understood." -> return_visit

node: sold
  odd_sam (smug): "A pleasure. Remember, you never heard it from me."
  > "Understood." -> return_visit

node: override
  odd_sam (low): "A service code. Every panel in the Stacks has one, and every superintendent forgets it. Four, four, oh, seven. You did not hear it from me, and it will not work twice if anyone is counting."
  > "Thank you." -> return_visit

node: haggled
  odd_sam (unsettled): "You talk like a government pamphlet. Fine, ten. It is a pleasure and a little frightening."
  > "Thank you." -> return_visit

node: sample
  odd_sam (shrugging): "It was true once. That is the most anyone can say for most information."
  > "Thanks." -> return_visit

node: pump4_claim
  odd_sam (sharp): "Is that so. Then you know my price was fair. Show it to me properly and I will tell you if it holds up."
  > "Show him." -> show
  > "Maybe later." -> return_visit

node: show
  odd_sam: "Let me see it."
  present:
    pump4_shift [reliability:true, !verified:pump4_shift] {verify:pump4_shift, +credits:15} -> confirmed
    pump4_shift [verified:pump4_shift] -> already
    pump4_shift_old [reliability:outdated] {disprove:pump4_shift_old} -> stale
    * -> shrug
  > "Never mind." -> return_visit

node: confirmed
  odd_sam (impressed): "That matches what I have. Here, for the confirmation."
  > "Pleasure doing business." -> return_visit

node: already
  odd_sam: "You have shown me that one. I do not pay twice for the same truth."
  > "Fair enough." -> return_visit

node: stale
  odd_sam (kind): "Stale. The night crew changed their habits last winter. Cross that one out."
  > "Noted." -> return_visit

node: shrug
  odd_sam (shrugging): "Interesting. And entirely useless to me."
  > "Fair enough." -> return_visit

node: goodbye
  odd_sam: "Mind the Wardens. They are very thorough about people with nothing to declare."
  end
