          "kind": "decision",
          "status": "implemented",
          "flag": "pallas_asked_want"
        },
        {
          "id": "allowed",
          "label": "You are allowed to want anything: trust up",
          "kind": "outcome",
          "status": "implemented",
          "flag": "pallas_asked_want"
        },
        {
          "id": "dismiss",
          "label": "You are a maintenance unit: trust down",
          "kind": "outcome",
          "status": "implemented",
          "flag": "pallas_asked_want"
        },
        {
          "id": "apology",
          "label": "Apologise: trust recovers",
