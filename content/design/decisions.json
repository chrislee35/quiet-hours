          "kind": "state",
          "status": "implemented",
          "flag": "pallas_arc_started"
        },
        {
          "id": "bench",
          "label": "Doc Perrin's bench: build the drive and press the tag",
          "kind": "decision",
          "status": "implemented",
          "flag": "pallas_arc_started"
        },
        {
          "id": "fixed",
          "label": "Her drive is repaired: trust up",
          "kind": "outcome",
          "status": "implemented",
          "flag": "pallas_repaired"
