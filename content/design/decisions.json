    {
      "id": "ending",
      "title": "The ending: companion, route, aftermath",
      "intro": "One companion, one of three routes, the same closing scene with only the companion's voice changing. A candidate is asked in person and must trust you and meet their practical requirement; each route then asks something more of them. Everyone ends up aware, and the fate of the Hollow, the Lull, the cell, Pallas and each person left behind is written as sequel flags, shown only lightly.",
      "nodes": [
        {
          "id": "cp",
          "label": "Who comes with you? Ask them; the last one asked, and ready, is the one",
          "kind": "decision",
          "status": "implemented",
          "flag": "companion"
        },
        {
          "id": "pallas",
          "label": "Pallas (partner): trusts you, repaired, tagged as cargo. Harder: robots are scanned differently",
          "kind": "outcome",
          "status": "implemented",
          "flag": "companion"
        },
        {
          "id": "june",
          "label": "June (ward): trusts you, Marrow consents, a child-sized way. Harder: slow, noisy; planned with the Hollow",
          "kind": "outcome",
          "status": "planned"
        },
        {
          "id": "odile",
          "label": "Odile (convert): trusts you, sees through the Lull. Harder: fragile; planned with the Lull",
          "kind": "outcome",
          "status": "planned"
        },
        {
          "id": "mentorc",
          "label": "Your mentor: trusts you, willing to leave, second identity filed. Harder: the sneak window shrinks",
          "kind": "outcome",
          "status": "implemented",
          "flag": "companion"
        },
        {
          "id": "rt",
          "label": "Which Gate route?",
          "kind": "decision",
          "status": "implemented",
          "flag": "route_taken"
        },
        {
          "id": "sneak",
          "label": "Sneak: Train 7, the service gate in the 13:50 window, a pass in hand",
          "kind": "outcome",
          "status": "implemented",
          "flag": "route_taken"
        },
        {
          "id": "hack",
          "label": "Hack: the controller, by the two code halves or by answering the Gate as its builder",
          "kind": "outcome",
          "status": "implemented",
          "flag": "route_taken"
        },
        {
          "id": "break",
          "label": "Break the Gate: cut Node 4, walk out through the open Gate; the cost falls on those left",
          "kind": "outcome",
          "status": "implemented",
          "flag": "route_taken"
        },
        {
          "id": "aware",
          "label": "Everyone is aware: in person, or by a message at the crossing",
          "kind": "outcome",
          "status": "implemented",
          "engine": true,
          "flag": "awake_pallas"
        },
        {
          "id": "scene",
          "label": "Closing scene: outside, gratitude, the turn, black, sequel card",
          "kind": "outcome",
          "status": "implemented",
          "engine": true,
          "flag": "sequel_done"
        },
        {
          "id": "flags",
          "label": "Sequel flags written at the crossing: who came, each person left behind (free, hiding, arrested or left; ally, wary or estranged), Hollow, Lull, cell, past stance",
          "kind": "state",
          "status": "implemented",
          "engine": true
        }
