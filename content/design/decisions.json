      "id": "pallas",
      "title": "Pallas and the one inventory puzzle",
      "intro": "Pallas is a candidate companion. Her trust moves a step at a time and is always recoverable; taking her out needs a repaired drive, a cargo tag and her consent. The parts are the game's single inventory puzzle.",
      "nodes": [
        {
          "id": "meet",
          "label": "Meet Pallas in the Safehouse",
          "kind": "state",
          "status": "implemented",
          "flag": "met_pallas"
