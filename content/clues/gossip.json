        "to": "cat_gag",
        "kind": "contradicts"
      }
    ],
    "for": [
      "gossip"
    ]
  },
  {
    "id": "cat_halloran",
    "text": "Halloran-7 has opened a file on the cat and says, warmly, that it is looking fuller.",
