        "kind": "contradicts"
      }
    ],
    "for": [
      "gossip"
    ]
  },
  {
    "id": "cat_host",
    "text": "The Host says the cat took the perfect drink at the Lull, left a tip in a currency the Host would not name, and was not dulled in the least.",
