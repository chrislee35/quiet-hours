      }
    ],
    "for": [
      "gossip"
    ]
  },
  {
    "id": "juno_petty_good",
    "text": "Juno is still against MERIDIAN and uses the toolkit only to open vending machines and one very good door.",
    "source": "npc:teeter",
    "reliability": "true",
    "tags": [
      "topic:gossip",
      "topic:hackers",
      "person:juno_park"
    ],
    "links": [
      {
        "to": "skeleton_renamed",
        "kind": "supports"
      }
    ],
    "for": [
      "gossip"
    ]
  },
  {
    "id": "mari_unbothered",
    "text": "Mari Quade has opened a noodle stall under the Stacks and says the toolkit is the best thing that ever happened to her friend.",
    "source": "npc:silas",
    "reliability": "true",
    "tags": [
      "topic:gossip",
      "topic:hackers",
      "person:mari_quade"
    ],
    "links": [],
    "for": [
      "gossip"
    ]
  },
  {
    "id": "hackers_reunion",
    "text": "The whole crew has booked the same table at the Lull on the same night. The Host has prepared four perfect drinks that nobody agrees on.",
    "source": "npc:host",
    "reliability": "true",
    "tags": [
      "topic:gossip",
      "topic:hackers",
      "person:host",
      "place:lull"
