      }
    ],
    "for": [
      "gossip"
    ]
  },
  {
    "id": "cat_request",
    "text": "Teeter is looking for a missing cat called Admiral Pancake: grey, one ear, answers to nothing.",
    "source": "npc:teeter",
    "reliability": "true",
    "tags": [
      "topic:gossip",
      "topic:cat",
      "person:teeter"
    ],
    "links": [],
    "for": [
      "gossip"
    ]
  },
  {
    "id": "cat_stairwell",
    "text": "Silas saw the cat in the third-floor stairwell, reading the notices and initialling them.",
