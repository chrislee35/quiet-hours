        "kind": "contradicts"
      }
    ],
    "for": [
      "gossip"
    ]
  },
  {
    "id": "cat_perrin",
    "text": "Doc Perrin says the cat held a consultation with Statistic the pigeon and the two of them reached a diagnosis he declines to repeat.",
