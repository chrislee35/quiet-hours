            "reinforced"
          ]
        }
      }
    ],
    "effects": [
      {
        "set_district": [
          "stacks",
          "patrolSet",
          "reinforced"
        ]
      }
    ]
  },
  {
    "id": "meridian_relaxes",
    "on": "MetricChanged",
    "if": [
